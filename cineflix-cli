    episodes_list_gql='query ($showId: String!) { show( _id: $showId ) { _id availableEpisodesDetail }}'

    curl --max-time 15 -e "$allanime_refr" -s -H "Content-Type: application/json" -X POST "${allanime_api}/api" --data "{\"variables\":{\"showId\":\"$*\"},\"query\":\"$episodes_list_gql\"}" -A "$agent" | sed -nE "s|.*$mode\":\[([0-9.\",]*)\].*|\1|p" | sed 's|,|\
|g; s|"||g' | sort -n -k 1
}

search_all() {
    _query="$1"
    _tab="$(printf '\t')"
    
    # Define temporary files for parallel results
    _tmp_anime=$(mktemp)
    _tmp_movie=$(mktemp)
    _tmp_tv=$(mktemp)
    
    trap 'rm -f "$_tmp_anime" "$_tmp_movie" "$_tmp_tv"' INT TERM EXIT
    
    if [ -z "$_query" ] || [ ${#_query} -lt 2 ]; then
        # Output the 4 categories/tabs
        printf '  📺  TV Shows          Search for television series\n'
        printf '  🎬  Movies            Search for feature films\n'
        printf '  🎌  Anime             Search for anime series\n'
        printf '  🕒  Resume / History  View recently watched titles\n'
        printf '  🔍  Search            Search for a title across all categories\n'
        return
    fi
    
    # Perform searches in parallel
    search_anime "$_query" 2>/dev/null | while IFS="$_tab" read -r _id _title || [ -n "$_id" ]; do
        [ -z "$_id" ] && continue
        printf "🎌 [ANIME] %-50s | ID:%s\n" "$_title" "$_id"
    done > "$_tmp_anime" &
    
    if [ -n "$TMDB_API_KEY" ]; then
        tmdb_media_type="movie" tmdb_search "$_query" 2>/dev/null | while read -r line || [ -n "$line" ]; do
            case "$line" in
                *" | ID:"*)
                    id_part=" | ID:${line##* | ID:}"
                    left="${line% | ID:*}"
                    left=$(printf "%s" "$left" | sed 's/[[:space:]]*\[MOVIE\]//; s/[[:space:]]*$//')
                    printf "🎬 [MOVIE] %-50s %s\n" "$left" "$id_part"
                    ;;
                *) ;;
            esac
        done > "$_tmp_movie" &
        
        tmdb_media_type="tv" tmdb_search "$_query" 2>/dev/null | while read -r line || [ -n "$line" ]; do
            case "$line" in
                *" | ID:"*)
                    id_part=" | ID:${line##* | ID:}"
                    left="${line% | ID:*}"
                    left=$(printf "%s" "$left" | sed 's/[[:space:]]*\[TV\]//; s/[[:space:]]*$//')
                    printf "📺 [TV]    %-50s %s\n" "$left" "$id_part"
                    ;;
                *) ;;
            esac
        done > "$_tmp_tv" &
    else
        : > "$_tmp_movie"
        : > "$_tmp_tv"
    fi
    
    wait
    
    cat "$_tmp_movie" "$_tmp_tv" "$_tmp_anime"
}

# PLAYING

process_hist_entry() {
    ep_list=$(episodes_list "$id")
    latest_ep=$(printf "%s\n" "$ep_list" | tail -n1)
    title=$(printf "%s\n" "$title" | sed "s|[0-9]\+ episodes|${latest_ep} episodes|")
    ep_no=$(printf "%s" "$ep_list" | sed -n "/^${ep_no}$/{n;p;}") 2>/dev/null
    [ -n "$ep_no" ] && printf "%s\t%s - episode %s\n" "$id" "$title" "$ep_no"
}

update_history() {
    tab="$(printf '\t')"
    if grep -q -E "^[^${tab}]+${tab}${id}${tab}" "$histfile"; then
        sed -E "s|^[^${tab}]+${tab}${id}${tab}[^${tab}]+$|${ep_no}${tab}${id}${tab}${title}|" "$histfile" >"${histfile}.new"
    else
        cp "$histfile" "${histfile}.new"
        printf "%s\t%s\t%s\n" "$ep_no" "$id" "$title" >>"${histfile}.new"
    fi
    mv "${histfile}.new" "$histfile"
}

download() {
    case $1 in
        *m3u8*)
            if command -v "yt-dlp" >/dev/null; then
                yt-dlp --referer "$m3u8_refr" "$1" --no-skip-unavailable-fragments --fragment-retries infinite -N 16 -o "$download_dir/$2.mp4"
            else
                ffmpeg -extension_picky 0 -referer "$m3u8_refr" -loglevel error -stats -i "$1" -c copy "$download_dir/$2.mp4"
            fi
            ;;
        *)
            # shellcheck disable=SC2086
            aria2c --referer="${refr_flag#--referrer=}" --enable-rpc=false --check-certificate=false --continue $iSH_DownFix --summary-interval=0 -x 16 -s 16 "$1" --dir="$download_dir" -o "$2.mp4" --download-result=hide
            ;;
    esac
}

android_mpv() {
    dir="/storage/emulated/0/mpv"
    file="$dir/mpv.config.mp4"
    if [ -w "${dir%*/mpv}" ]; then
        [ -d "${dir}" ] || mkdir "${dir}"
        printf "%s" "$3" | sed 's| --|\n|g; s|^--||g' >"$file"
    fi
    am start --user 0 -a android.intent.action.VIEW -d "$1" -n is.xyz.mpv/.MPVActivity -e "title" "$2" >/dev/null 2>&1
    unset dir file
}

play_episode() {
    [ "$log_episode" = 1 ] && [ "$player_function" != "debug" ] && [ "$player_function" != "download" ] && command -v logger >/dev/null && logger -t cineflix-cli "${allanime_title}${ep_no}"
    [ "$skip_intro" = 1 ] && skip_flag="$(ani-skip -q "$mal_id" -e "$ep_no")"
    [ -z "$episode" ] && get_episode_url
    
    if [ "$is_movie" = 1 ]; then
        _media_title="$allanime_title"
    else
        _media_title="${allanime_title}Episode ${ep_no}"
    fi

    # shellcheck disable=SC2086
    case "$player_function" in
        debug)
            printf "All links:\n%s\nSelected link:\n" "$links"
            printf "%s\n" "$episode"
            ;;
        mpv*)
            if [ "$no_detach" = 0 ]; then
                nohup $player_function $skip_flag --tls-verify=no --force-media-title="$_media_title" "$episode" $refr_flag >/dev/null 2>&1 &
            else
                $player_function $skip_flag $refr_flag --tls-verify=no --force-media-title="$_media_title" "$episode"
                mpv_exitcode=$?
                [ "$exit_after_play" = 1 ] && [ -z "$range" ] && exit "$mpv_exitcode"
            fi
            ;;
        android_mpv) "$player_function" "$episode" "$_media_title" "--tls-verify=no $refr_flag" 2>&1 & ;;
        android_vlc) nohup am start --user 0 -a android.intent.action.VIEW -d "$episode" -n org.videolan.vlc/org.videolan.vlc.gui.video.VideoPlayerActivity -e "title" "$_media_title" >/dev/null 2>&1 & ;;
        *iina*)
            [ -n "$refr_flag" ] && refr_flag="--mpv-${refr_flag#--}"
            if pgrep -f "IINA" >/dev/null 2>&1; then
                # omit --keep-running when an IINA instance exists to prevent hanging
                nohup $player_function --no-stdin --mpv-tls-verify=no --mpv-force-media-title="$_media_title" $refr_flag "$episode" >/dev/null 2>&1 &
            else
                nohup $player_function --no-stdin --mpv-tls-verify=no --keep-running --mpv-force-media-title="$_media_title" $refr_flag "$episode" >/dev/null 2>&1 &
            fi
            ;;
        flatpak_mpv) flatpak run io.mpv.Mpv --tls-verify=no --force-media-title="$_media_title" "$episode" $refr_flag >/dev/null 2>&1 & ;;
        vlc*) nohup $player_function --http-referrer="${refr_flag#--referrer=}" --play-and-exit --meta-title="$_media_title" "$episode" >/dev/null 2>&1 & ;;
        *yncpla*) nohup $player_function "$episode" -- --tls-verify=no --force-media-title="$_media_title" $refr_flag >/dev/null 2>&1 & ;;
        download) "$player_function" "$episode" "$_media_title" ;;
        catt) nohup catt cast "$episode" >/dev/null 2>&1 & ;;
        iSH)
            printf "\e]8;;vlc://%s\a~~~~~~~~~~~~~~~~~~~~\n~ Tap to open VLC ~\n~~~~~~~~~~~~~~~~~~~~\e]8;;\a\n" "$episode"
            sleep 5
            ;;
        *) nohup $player_function "$episode" >/dev/null 2>&1 & ;;
    esac
    replay="$episode"
    unset episode
    # movie/TV streams are keyed by TMDB, not the anime history schema; skip until Phase 5
    [ "$media_mode" != "movie" ] && update_history
    [ "$use_external_menu" = "1" ] && wait
    [ "$use_external_menu" = "2" ] && wait
}

play() {
    start=$(printf "%s" "$ep_no" | grep -Eo '^(-1|[0-9]+(\.[0-9]+)?)')
    end=$(printf "%s" "$ep_no" | grep -Eo '(-1|[0-9]+(\.[0-9]+)?)$')
    [ "$start" = "-1" ] && ep_no=$(printf "%s" "$ep_list" | tail -n1) && unset start
    [ -z "$end" ] || [ "$end" = "$start" ] && unset start end
    [ "$end" = "-1" ] && end=$(printf "%s" "$ep_list" | tail -n1)
    line_count=$(printf "%s\n" "$ep_no" | wc -l | tr -d "[:space:]")
    if [ "$line_count" != 1 ] || [ -n "$start" ]; then
        [ -z "$start" ] && start=$(printf "%s\n" "$ep_no" | head -n1)
        [ -z "$end" ] && end=$(printf "%s\n" "$ep_no" | tail -n1)
        range=$(printf "%s\n" "$ep_list" | sed -nE "/^${start}\$/,/^${end}\$/p")
        [ -z "$range" ] && die "Invalid range!"
        for i in $range; do
            tput clear
            ep_no=$i
            set_term_title "Cineflix │ Streaming: Episode $ep_no"
            log_info "Playing episode $ep_no…"
            [ "$i" = "$end" ] && unset range
            play_episode
        done
    else
        play_episode
    fi
    # moves up to stored position and deletes to end
    [ "$player_function" != "debug" ] && [ "$player_function" != "download" ] && tput rc && tput ed
}

# MOVIE/TV (cineflix)

tmdb_api="https://api.themoviedb.org/3"

# core (scraper) connection. By default we use the hosted production instance
# so streaming works with zero local setup. CINEFLIX_CORE_URL targets any
# already-running instance as-is; setting CINEFLIX_CORE_HOST/PORT/DIR (without a
# URL) switches to a local embedded core that this script starts and stops.
core_prod_url="https://core.cineflix.dev"
core_host="${CINEFLIX_CORE_HOST:-localhost}"
core_port="${CINEFLIX_CORE_PORT:-3005}"
core_pid=""
core_manage=0
if [ -n "$CINEFLIX_CORE_URL" ]; then
    core_url="$CINEFLIX_CORE_URL"
elif [ -n "$CINEFLIX_CORE_HOST" ] || [ -n "$CINEFLIX_CORE_PORT" ] || [ -n "$CINEFLIX_CORE_DIR" ]; then
    core_url="http://${core_host}:${core_port}"
    core_manage=1
else
    core_url="$core_prod_url"
fi
core_url="${core_url%/}"

# returns 0 when the core server answers a health check
core_health() {
    _code=$(curl --max-time 5 -s -o /dev/null -w '%{http_code}' "${core_url}/v1/health" 2>/dev/null)
    [ "$_code" = "200" ]
}

# stops the embedded core if this script started it
stop_core() {
    [ -n "$core_pid" ] && kill "$core_pid" >/dev/null 2>&1
    core_pid=""
}

# starts the embedded core in the background and waits until it is ready,
# passing our host/port/key so dotenv keeps them and we know where to connect
start_core() {
    dep_ch "node"
    [ -x "$core_dir/node_modules/.bin/tsx" ] || die "cineflix core dependencies are missing. Run \"npm install\" in \"$core_dir\"."
    (cd "$core_dir" && PORT="$core_port" HOST="$core_host" TMDB_API_KEY="$TMDB_API_KEY" exec ./node_modules/.bin/tsx src/server.ts) >/dev/null 2>&1 &
    core_pid=$!
    trap 'stop_core; cleanup' EXIT
    trap 'stop_core; cleanup; exit 1' INT HUP TERM
    _tries=0
    until core_health; do
        kill -0 "$core_pid" 2>/dev/null || die "cineflix core failed to start. Check \"$core_dir\"."
        _tries=$((_tries + 1))
        [ "$_tries" -ge 60 ] && die "cineflix core did not become ready in time."
        sleep 0.5
    done
}

# resolves a playable stream link for the chosen media via the configured core
# $1=type(movie|tv) $2=tmdb_id [$3=season $4=episode]; result is set in STREAM_URL
resolve_stream_sources() {
    # local embedded fallback only: ensure a core is running before resolving.
    # the hosted/explicit-URL paths skip this entirely and fetch directly.
    if [ "$core_manage" = 1 ]; then
        [ -d "$core_dir" ] || die "cineflix core not found at \"$core_dir\". Set CINEFLIX_CORE_DIR to override."
        if ! core_health; then
            log_info "Starting cineflix core…"
            start_core
        fi
    fi

    if [ "$1" = "tv" ]; then
        _endpoint="${core_url}/v1/tv/${2}/seasons/${3}/episodes/${4}"
    else
        _endpoint="${core_url}/v1/movies/${2}"
    fi

    spin_start "Resolving streaming sources…"
    _resp=$(curl --max-time 15 -s -w '\n%{http_code}' "$_endpoint") || { spin_stop; die "Error: cineflix core not reachable at \"$core_url\"."; }
    spin_stop
    _code=$(printf "%s" "$_resp" | tail -n1)
    _body=$(printf "%s" "$_resp" | sed '$d')

    if [ "$_code" != "200" ]; then
        _msg=$(printf "%s" "$_body" | jq -r '.error.message // "unknown error"' 2>/dev/null)
        die "Error: Could not extract streaming sources from core ($_msg)."
    fi

    STREAM_URL=$(printf "%s" "$_body" | jq -r '.sources[0].url // empty' 2>/dev/null)
    [ -z "$STREAM_URL" ] && die "Error: Could not extract streaming sources from core."

    # provider links are proxied relative to the core server; make them absolute
    case "$STREAM_URL" in
        http*) ;;
        *) STREAM_URL="${core_url}${STREAM_URL}" ;;
    esac
}

# search TMDB for movies and tv shows, output one "Title (Year) [TYPE] | ID:n" line per result
tmdb_search() {
    _query=$(printf "%s" "$1" | tr '+' ' ')
    _enc=$(jq -rn --arg q "$_query" '$q|@uri')
    _type="${tmdb_media_type:-multi}"
    _resp=$(curl --max-time 15 -s "${tmdb_api}/search/${_type}?api_key=${TMDB_API_KEY}&query=${_enc}&include_adult=false")
    if printf "%s" "$_resp" | jq -e '.success == false' >/dev/null 2>&1; then
        _err=$(printf "%s" "$_resp" | jq -r '.status_message // "unknown error"')
        die "TMDB API error: $_err"
    fi
    case "$_type" in
        movie)
            printf "%s" "$_resp" | jq -r '
                .results[]?
                | (.release_date // "") as $date
                | (if ($date | length) >= 4 then $date[0:4] else "N/A" end) as $year
                | "\(.title) (\($year)) [MOVIE] | ID:\(.id)"'
            ;;
        tv)
            printf "%s" "$_resp" | jq -r '
                .results[]?
                | (.first_air_date // "") as $date
                | (if ($date | length) >= 4 then $date[0:4] else "N/A" end) as $year
                | "\(.name) (\($year)) [TV] | ID:\(.id)"'
            ;;
        *)
            printf "%s" "$_resp" | jq -r '
                .results[]?
                | select(.media_type == "movie" or .media_type == "tv")
                | (if .media_type == "movie" then .title else .name end) as $title
                | (if .media_type == "movie" then .release_date else .first_air_date end) as $date
                | (($date // "") | if length >= 4 then .[0:4] else "N/A" end) as $year
                | "\($title) (\($year)) [\(.media_type | ascii_upcase)] | ID:\(.id)"'
            ;;
    esac
}

# format tmdb results into aligned columns for fzf display
tmdb_format_results() {
    while read -r line || [ -n "$line" ]; do
        case "$line" in
            *" | ID:"*)
                id_part=" | ID:${line##* | ID:}"
                left="${line% | ID:*}"
                type_tag=""
                case "$left" in
                    *"[MOVIE]"*)
                        type_tag="[MOVIE]"
                        left=$(printf "%s" "$left" | sed 's/[[:space:]]*\[MOVIE\]//')
                        ;;
                    *"[TV]"*)
                        type_tag="[TV]   "
                        left=$(printf "%s" "$left" | sed 's/[[:space:]]*\[TV\]//')
                        ;;
                    *) ;;
                esac
                left=$(printf "%s" "$left" | sed 's/[[:space:]]*$//')
                printf "  %-44s  %-8s %s\n" "$left" "$type_tag" "$id_part"
                ;;
            *)
                printf "%s\n" "$line"
                ;;
        esac
    done
}

# prompt for a positive integer, re-asking until the input is valid
read_integer() {
    _int=""
    while [ -z "$_int" ]; do
        printf "\033[1;36m%s\033[0m" "$1" >&2
        read -r _int
        case "$_int" in
            '' | *[!0-9]*) log_warn "Please enter a valid number." && _int="" ;;
            *) ;;
        esac
    done
    printf "%s" "$_int"
}

# write a movie/TV entry to the shared history file, replacing any prior entry
# for the same title. $1=entry line, $2=ERE matching the old line to drop.
# entries are prefixed with [MOVIE]/[TV] so the anime reader can skip them.
movie_save_history() {
    grep -v -E "$2" "$histfile" >"${histfile}.new" 2>/dev/null
    printf "%s\n" "$1" >>"${histfile}.new"
    mv "${histfile}.new" "$histfile"
}

# resolve and hand a chosen title to the native player/downloader pipeline,
# logging it to history. $1=type(movie|tv) $2=tmdb_id $3=display_title
# [$4=season $5=episode]. play_episode handles both playback and -d downloads.
movie_play() {
    if [ "$1" = "tv" ]; then
        resolve_stream_sources "tv" "$2" "$4" "$5"
        ep_no="$5"
        is_movie=0
        allanime_title="$3 S$4 "
        movie_save_history "[TV] $3 | $2 | S$4E$5" "^\[TV\] .* \| $2 \|"
    else
        resolve_stream_sources "movie" "$2"
        ep_no=""
        is_movie=1
        allanime_title="$3"
        movie_save_history "[MOVIE] $3 | $2" "^\[MOVIE\] .* \| $2$"
    fi
    links="$STREAM_URL"
    episode="$STREAM_URL"
    # force foreground playback only if using a local core so it stays alive until the player exits
    [ "$core_manage" = 1 ] && no_detach=1
    set_term_title "Cineflix │ Streaming: $3"
    log_success "Playing: $3"
    play_episode
}

# replay a title chosen from the resume menu. $1 = the selected history line.
# TV entries offer the saved season/episode or let the user pick a different one.
movie_resume() {
    case "$1" in
        '[MOVIE]'*)
            _rtitle=$(printf "%s" "$1" | sed -nE 's/^\[MOVIE\] (.*) \| [0-9]+$/\1/p')
            _rid=$(printf "%s" "$1" | sed -nE 's/.*\| ([0-9]+)$/\1/p')
            movie_play "movie" "$_rid" "$_rtitle"
            ;;
        '[TV]'*)
            _rtitle=$(printf "%s" "$1" | sed -nE 's/^\[TV\] (.*) \| [0-9]+ \| S[0-9]+E[0-9]+$/\1/p')
            _rid=$(printf "%s" "$1" | sed -nE 's/^\[TV\] .* \| ([0-9]+) \| S[0-9]+E[0-9]+$/\1/p')
            _rseason=$(printf "%s" "$1" | sed -nE 's/.*\| S([0-9]+)E[0-9]+$/\1/p')
            _rep=$(printf "%s" "$1" | sed -nE 's/.*E([0-9]+)$/\1/p')
            printf "\33[2K\r" >&2
            log_info "Resume $_rtitle S${_rseason}E${_rep}?"
            printf '\033[1;36m     [Y/n] \033[0m' >&2
            read -r _rans
            case "$_rans" in
                [Nn]*)
                    printf '\n' >&2
                    printf '\033[1;36m  ╭─── %s ───╮\033[0m\n' "$_rtitle" >&2
                    printf '\033[0;90m  │\033[0m\n' >&2
                    _rseason=$(read_integer "  │  Season ➜ ")
                    _rep=$(read_integer "  │  Episode ➜ ")
                    printf '\033[0;90m  │\033[0m\n' >&2
                    _box_w=$((${#_rtitle} + 6))
                    _box_line=$(printf '%*s' "$_box_w" '' | tr ' ' '─')
                    printf '\033[1;36m  ╰%s╯\033[0m\n' "$_box_line" >&2
                    ;;
                *) ;;
            esac
            movie_play "tv" "$_rid" "$_rtitle" "$_rseason" "$_rep"
            ;;
        *) ;;
    esac
}

run_tv_selection() {
    tmdb_id="$1"
    display_title="$2"
    # Fetch seasons
    spin_start "Fetching series metadata..."
    _seasons_json=$(curl --max-time 15 -s "${tmdb_api}/tv/${tmdb_id}?api_key=${TMDB_API_KEY}")
    spin_stop
    _seasons_list=$(printf "%s" "$_seasons_json" | jq -r '
        .seasons[]?
        | select(.season_number > 0)
        | "Season \(.season_number) (\(.episode_count) episodes) - \(.name // "")"' 2>/dev/null)

    if [ -n "$_seasons_list" ] && [ "$use_external_menu" = "0" ]; then
        _selected_season=$(printf "%s\n" "$_seasons_list" | launcher "" "Select Season: ")
        [ -z "$_selected_season" ] && exit 0
        season=$(printf "%s" "$_selected_season" | sed -nE 's/Season ([0-9]+).*/\1/p')

        spin_start "Fetching episodes..."
        _episodes_json=$(curl --max-time 15 -s "${tmdb_api}/tv/${tmdb_id}/season/${season}?api_key=${TMDB_API_KEY}")
        spin_stop
        _episodes_list=$(printf "%s" "$_episodes_json" | jq -r '
            .episodes[]?
            | "Episode \(.episode_number): \(.name // "Episode \(.episode_number)")"' 2>/dev/null)

        if [ -n "$_episodes_list" ]; then
            _selected_ep=$(printf "%s\n" "$_episodes_list" | launcher "" "Select Episode: ")
            [ -z "$_selected_ep" ] && exit 0
            episode_no=$(printf "%s" "$_selected_ep" | sed -nE 's/Episode ([0-9]+).*/\1/p')
        else
            episode_no=$(read_integer "  │  Episode ➜ ")
        fi
    else
        # Fallback
        printf '\n' >&2
        printf '\033[1;36m  ╭─── %s ───╮\033[0m\n' "$display_title" >&2
        printf '\033[0;90m  │\033[0m\n' >&2
        season=$(read_integer "  │  Season ➜ ")
        episode_no=$(read_integer "  │  Episode ➜ ")
        printf '\033[0;90m  │\033[0m\n' >&2
        _box_w=$((${#display_title} + 6))
        _box_line=$(printf '%*s' "$_box_w" '' | tr ' ' '─')
        printf '\033[1;36m  ╰%s╯\033[0m\n' "$_box_line" >&2
    fi

    # Play loop for TV show
    while true; do
        movie_play "tv" "$tmdb_id" "$display_title" "$season" "$episode_no"

        # Prompt for next action
        cmd=$(printf "next\nreplay\nprevious\nselect\nquit" | launcher "" "Playing S${season}E${episode_no} of $display_title... ")
        [ -z "$cmd" ] && cmd="quit"

        case "$cmd" in
            next)
                _max_eps=$(curl --max-time 15 -s "${tmdb_api}/tv/${tmdb_id}/season/${season}?api_key=${TMDB_API_KEY}" | jq '.episodes | length' 2>/dev/null)
                if [ -n "$_max_eps" ] && [ "$_max_eps" -eq "$_max_eps" ] 2>/dev/null; then
                    if [ "$episode_no" -lt "$_max_eps" ]; then
                        episode_no=$((episode_no + 1))
                    else
                        # Check next season
                        _max_seasons=$(printf "%s" "$_seasons_json" | jq '.number_of_seasons' 2>/dev/null)
                        if [ -n "$_max_seasons" ] && [ "$season" -lt "$_max_seasons" ]; then
                            season=$((season + 1))
                            episode_no=1
                            log_info "Moving to Season $season Episode 1"
                            sleep 1
                        else
                            log_warn "Already at the last episode of the series."
                            sleep 1
                        fi
                    fi
                else
                    episode_no=$((episode_no + 1))
                fi
                ;;
            replay)
                ;;
            previous)
                if [ "$episode_no" -gt 1 ]; then
                    episode_no=$((episode_no - 1))
                else
                    if [ "$season" -gt 1 ]; then
                        season=$((season - 1))
                        _prev_max_eps=$(curl --max-time 15 -s "${tmdb_api}/tv/${tmdb_id}/season/${season}?api_key=${TMDB_API_KEY}" | jq '.episodes | length' 2>/dev/null)
                        if [ -n "$_prev_max_eps" ] && [ "$_prev_max_eps" -eq "$_prev_max_eps" ] 2>/dev/null; then
                            episode_no="$_prev_max_eps"
                        else
                            episode_no=1
                        fi
                        log_info "Moving to Season $season Episode $episode_no"
                        sleep 1
                    else
                        log_warn "Already at Season 1 Episode 1."
                        sleep 1
                    fi
                fi
                ;;
            select)
                _seasons_json=$(curl --max-time 15 -s "${tmdb_api}/tv/${tmdb_id}?api_key=${TMDB_API_KEY}")
                _seasons_list=$(printf "%s" "$_seasons_json" | jq -r '
                    .seasons[]?
                    | select(.season_number > 0)
                    | "Season \(.season_number) (\(.episode_count) episodes) - \(.name // "")"' 2>/dev/null)
                if [ -n "$_seasons_list" ] && [ "$use_external_menu" = "0" ]; then
                    _selected_season=$(printf "%s\n" "$_seasons_list" | launcher "" "Select Season: ")
                    if [ -n "$_selected_season" ]; then
                        season=$(printf "%s" "$_selected_season" | sed -nE 's/Season ([0-9]+).*/\1/p')
                        _episodes_json=$(curl --max-time 15 -s "${tmdb_api}/tv/${tmdb_id}/season/${season}?api_key=${TMDB_API_KEY}")
                        _episodes_list=$(printf "%s" "$_episodes_json" | jq -r '
                            .episodes[]?
                            | "Episode \(.episode_number): \(.name // "Episode \(.episode_number)")"' 2>/dev/null)
                        if [ -n "$_episodes_list" ]; then
                            _selected_ep=$(printf "%s\n" "$_episodes_list" | launcher "" "Select Episode: ")
                            [ -n "$_selected_ep" ] && episode_no=$(printf "%s" "$_selected_ep" | sed -nE 's/Episode ([0-9]+).*/\1/p')
                        fi
                    fi
                else
                    season=$(read_integer "  │  Season ➜ ")
                    episode_no=$(read_integer "  │  Episode ➜ ")
                fi
                ;;
            *)
                cleanup
                exit 0
                ;;
        esac
    done
}

# parallel pipeline entrypoint for Movie/TV mode, leaving the anime flow untouched
run_movie_mode() {
    [ -z "$TMDB_API_KEY" ] && die "TMDB_API_KEY is not set. Get a free key at https://www.themoviedb.org/settings/api then run: export TMDB_API_KEY=your_key"

    # no query supplied: offer a resume menu of recently watched movies/shows
    if [ -z "$query" ]; then
        _recent=$(grep -E '^\[(MOVIE|TV)\] ' "$histfile" 2>/dev/null)
        if [ -n "$_recent" ]; then
            _sel=$(printf "> Search for a new title\n%s\n" "$_recent" | launcher "" "Resume or search: ")
            [ -z "$_sel" ] && exit 1
            case "$_sel" in
                '[MOVIE]'* | '[TV]'*)
                    movie_resume "$_sel"
                    return
                    ;;
                *) ;;
            esac
        fi
    fi

    if [ "$use_external_menu" = "0" ]; then
        while [ -z "$query" ]; do
            printf '\033[1;36m [➜] Search movie/TV: \033[0m' && read -r query
        done
    else
        [ -z "$query" ] && query=$(printf "" | external_menu "" "Search movie/TV: " "$external_menu_args")
        [ -z "$query" ] && exit 1
    fi

    set_term_title "Cineflix │ Searching: $(printf '%s' "$query" | tr '+' ' ' || true)"
    spin_start "Searching TMDB…"
    results=$(tmdb_search "$query")
    spin_stop
    [ -z "$results" ] && die "No results found!"
    results=$(printf "%s\n" "$results" | tmdb_format_results)

    set_term_title "Cineflix │ Select"
    if [ -n "$index" ] && [ "$index" -eq "$index" ] 2>/dev/null; then
        choice=$(printf "%s\n" "$results" | sed -n "${index}p")
    else
        choice=$(printf "%s\n" "$results" | launcher "" "Select movie/show: ")
    fi
    [ -z "$choice" ] && exit 1

    media_type=$(printf "%s" "$choice" | sed -nE 's/.*\[(MOVIE|TV)\].*/\1/p' | tr '[:upper:]' '[:lower:]')
    tmdb_id=$(printf "%s" "$choice" | sed -nE 's/.*ID:([0-9]+).*/\1/p')
    [ -z "$tmdb_id" ] && die "Could not parse selection!"
    display_title=$(printf "%s" "$choice" | sed -nE 's/^(.*) \[(MOVIE|TV)\].*/\1/p' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')

    if [ "$media_type" = "tv" ]; then
        run_tv_selection "$tmdb_id" "$display_title"
    else
        movie_play "movie" "$tmdb_id" "$display_title"
    fi
}

show_history_menu() {
    if [ ! -f "$histfile" ] || [ ! -s "$histfile" ]; then
        die "History is empty!"
    fi

    # Read and format the items
    _tab="$(printf '\t')"
    _list=$(while read -r line || [ -n "$line" ]; do
        if printf "%s" "$line" | grep -q "$_tab"; then
            # Anime entry: ep_no, id, title
            ep_no=$(printf "%s" "$line" | cut -f1)
            id=$(printf "%s" "$line" | cut -f2)
            title=$(printf "%s" "$line" | cut -f3)
            printf "  🎌  [ANIME] %s - Episode %s | %s\n" "$title" "$ep_no" "$id"
        else
            # Movie/TV entry
            case "$line" in
                '[MOVIE]'*)
                    content=$(printf "%s" "$line" | sed 's/^\[MOVIE\] //')
                    printf "  🎬  [MOVIE] %s\n" "$content"
                    ;;
                '[TV]'*)
                    content=$(printf "%s" "$line" | sed 's/^\[TV\] //')
                    printf "  📺  [TV] %s\n" "$content"
                    ;;
                *) ;;
            esac
        fi
    done < "$histfile" | tac)

    [ -z "$_list" ] && die "No items found in history!"

    _choice=$(printf "%s\n" "$_list" | launcher "" "Resume: ")
    [ -z "$_choice" ] && exit 0

    case "$_choice" in
        *\[ANIME\]*)
            id=$(printf "%s" "$_choice" | sed -nE 's/.*\|[[:space:]]*(.*)/\1/p')
            tab="$(printf '\t')"
            _entry=$(grep -E "^[^$tab]+$tab${id}$tab" "$histfile" | tail -n1)
            ep_no=$(printf "%s" "$_entry" | cut -f1)
            title=$(printf "%s" "$_entry" | cut -f3)
            media_mode="anime"
            search="history"
            ep_list=$(episodes_list "$id")
            allanime_title="$(printf "%s" "$title" | cut -d'(' -f1 | tr -d '[:punct:]')"
            skip_search=1
            ;;
        *\[MOVIE\]*)
            [ -z "$TMDB_API_KEY" ] && die "TMDB_API_KEY is not set. Get a free key at https://www.themoviedb.org/settings/api then run: export TMDB_API_KEY=your_key"
            _line=$(printf "%s" "$_choice" | sed 's/^[[:space:]]*🎬[[:space:]]*\[MOVIE\][[:space:]]*//')
            movie_resume "[MOVIE] $_line"
            exit 0
            ;;
        *\[TV\]*)
            [ -z "$TMDB_API_KEY" ] && die "TMDB_API_KEY is not set. Get a free key at https://www.themoviedb.org/settings/api then run: export TMDB_API_KEY=your_key"
            _line=$(printf "%s" "$_choice" | sed 's/^[[:space:]]*📺[[:space:]]*\[TV\][[:space:]]*//')
            movie_resume "[TV] $_line"
            exit 0
            ;;
        *) ;;
    esac
}

# ── Interactive unified landing UI ───────────────────────────────
# Displays the CINEFLIX splash logo and prompts for the mode, then the query.
interactive_mode() {
    if [ "$use_external_menu" -ne 0 ]; then
        # Rofi/Dmenu fallback loop
        while true; do
            _query=$(printf "" | external_menu "" "Search (Movie/TV/Anime): " "$external_menu_args")
            [ -z "$_query" ] && cleanup && exit 0
            
            _results=$(search_all "$_query")
            if [ -z "$_results" ]; then
                log_warn "No results found!"
                sleep 1
                continue
            fi
            
            _selection=$(printf "%s\n" "$_results" | launcher "" "Select title: ")
            [ -z "$_selection" ] && continue
            break
        done
    else
        # FZF unified TUI Search Bar
        tput clear
        _cols=$(tput cols 2>/dev/null || printf '80')
        _logo_w=50
        _pad=$(( (_cols - _logo_w) / 2 ))
        [ "$_pad" -lt 0 ] && _pad=0
        _sp=$(printf '%*s' "$_pad" '')
        
        printf '\n\033[38;5;203m%s\033[0m\n\033[38;5;203m%s\033[0m\n\033[38;5;203m%s\033[0m\n\033[38;5;203m%s\033[0m\n\033[38;5;203m%s\033[0m\n\n' \
            "${_sp} ██████  ██  ███   ██  █████  █████  ██     ██  ██  ██" \
            "${_sp}██       ██  ████  ██  ██     ██     ██     ██   ████ " \
            "${_sp}██       ██  ██ ██ ██  ████   ████   ██     ██    ██  " \
            "${_sp}██       ██  ██  ████  ██     ██     ██     ██   ████ " \
            "${_sp} ██████  ██  ██   ███  █████  ██     █████  ██  ██  ██"

        _grey='\033[38;5;244m'
        _reset='\033[0m'
        
        _header=$(printf "\n ${_grey}CINEFLIX CLI — version %s by simoabid${_reset}\n" "$version_number")
        
        _initial_list=$(search_all "")
        
        # Calculate horizontal margin to center a ~80-col box
        _box_w=80
        _h_margin=$(( (_cols - _box_w) / 2 ))
        [ "$_h_margin" -lt 2 ] && _h_margin=2
        
        _selection=$(printf "%s\n" "$_initial_list" | fzf --reverse \
            --height="10" \
            --info=hidden \
            --ansi \
            --prompt=" Search anything... " \
            --header="$_header" \
            --border=bold \
            --margin="0,${_h_margin}" \
            --padding="0,1" \
            --color='bg+:#242938,fg+:#ffffff,hl:#00bcd4,hl+:#00e5ff,pointer:#00e5ff,prompt:#888888,border:#aaaaaa,header:#555555' \
            --bind "change:reload($0 --search-all {q})")
            
        _exit_status=$?
        if [ "$_exit_status" -ne 0 ] || [ -z "$_selection" ]; then
            cleanup
            exit 0
        fi
    fi
    
    case "$_selection" in
        *'TV Shows'*)
            [ -z "$TMDB_API_KEY" ] && die "TMDB_API_KEY is not set. Get a free key at https://www.themoviedb.org/settings/api then run: export TMDB_API_KEY=your_key"
            media_mode="movie"
            tmdb_media_type="tv"
            if [ "$use_external_menu" = "0" ]; then
                while [ -z "$query" ]; do
                    printf '\033[1;36m [➜] Search TV Shows: \033[0m' && read -r query
                done
            else
                [ -z "$query" ] && query=$(printf "" | external_menu "" "Search TV Shows: " "$external_menu_args")
                [ -z "$query" ] && exit 1
            fi
            set_term_title "Cineflix │ Searching: $(printf '%s' "$query" | tr '+' ' ' || true)"
            spin_start "Searching TMDB…"
            results=$(tmdb_search "$query")
            spin_stop
            [ -z "$results" ] && die "No results found!"
            results=$(printf "%s\n" "$results" | tmdb_format_results)
            set_term_title "Cineflix │ Select"
            choice=$(printf "%s\n" "$results" | launcher "" "Select TV Show: ")
            [ -z "$choice" ] && exit 1
            tmdb_id=$(printf "%s" "$choice" | sed -nE 's/.*ID:([0-9]+).*/\1/p')
            display_title=$(printf "%s" "$choice" | sed -nE 's/^(.*) \[(MOVIE|TV)\].*/\1/p' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
            run_tv_selection "$tmdb_id" "$display_title"
            ;;
        *'Movies'*)
            [ -z "$TMDB_API_KEY" ] && die "TMDB_API_KEY is not set. Get a free key at https://www.themoviedb.org/settings/api then run: export TMDB_API_KEY=your_key"
            media_mode="movie"
            tmdb_media_type="movie"
            if [ "$use_external_menu" = "0" ]; then
                while [ -z "$query" ]; do
                    printf '\033[1;36m [➜] Search Movies: \033[0m' && read -r query
                done
            else
                [ -z "$query" ] && query=$(printf "" | external_menu "" "Search Movies: " "$external_menu_args")
                [ -z "$query" ] && exit 1
            fi
            set_term_title "Cineflix │ Searching: $(printf '%s' "$query" | tr '+' ' ' || true)"
            spin_start "Searching TMDB…"
            results=$(tmdb_search "$query")
            spin_stop
            [ -z "$results" ] && die "No results found!"
            results=$(printf "%s\n" "$results" | tmdb_format_results)
            set_term_title "Cineflix │ Select"
            choice=$(printf "%s\n" "$results" | launcher "" "Select Movie: ")
            [ -z "$choice" ] && exit 1
            tmdb_id=$(printf "%s" "$choice" | sed -nE 's/.*ID:([0-9]+).*/\1/p')
            display_title=$(printf "%s" "$choice" | sed -nE 's/^(.*) \[(MOVIE|TV)\].*/\1/p' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
            movie_play "movie" "$tmdb_id" "$display_title"
            ;;
        *'Anime'*)
            media_mode="anime"
            if [ "$use_external_menu" = "0" ]; then
                while [ -z "$query" ]; do
                    printf '\033[1;36m [➜] Search Anime: \033[0m' && read -r query
                done
            else
                [ -z "$query" ] && query=$(printf "" | external_menu "" "Search Anime: " "$external_menu_args")
                [ -z "$query" ] && exit 1
            fi
            query=$(printf "%s" "$query" | sed "s| |+|g")
            set_term_title "Cineflix │ Searching: $(printf '%s' "$query" | tr '+' ' ' || true)"
            spin_start "Searching anime…"
            anime_list=$(search_anime "$query")
            spin_stop
            [ -z "$anime_list" ] && die "No results found!"
            result=$(printf "%s" "$anime_list" | nl -w 2 | sed 's/^[[:space:]]//' | nth "Select Anime: ")
            [ -z "$result" ] && exit 1
            title=$(printf "%s" "$result" | cut -f2)
            id=$(printf "%s" "$result" | cut -f1)
            ep_list=$(episodes_list "$id")
            ep_no=$(printf "%s" "$ep_list" | nth "Select Episode: " "$multi_selection_flag")
            [ -z "$ep_no" ] && exit 1
            allanime_title="$(printf "%s" "$title" | cut -d'(' -f1 | tr -d '[:punct:]')"
            play
            ;;
        *'History'*)
            show_history_menu
            ;;
        *'[MOVIE]'*)
            [ -z "$TMDB_API_KEY" ] && die "TMDB_API_KEY is not set. Get a free key at https://www.themoviedb.org/settings/api then run: export TMDB_API_KEY=your_key"
            _title=$(printf "%s" "$_selection" | sed -nE 's/.*\[MOVIE\][[:space:]]+(.*)[[:space:]]+\|[[:space:]]+ID:.*/\1/p' | sed 's/[[:space:]]*$//')
            _id=$(printf "%s" "$_selection" | sed -nE 's/.*ID:(.*)$/\1/p')
            movie_play "movie" "$_id" "$_title"
            ;;
        *'[TV]'*)
            [ -z "$TMDB_API_KEY" ] && die "TMDB_API_KEY is not set. Get a free key at https://www.themoviedb.org/settings/api then run: export TMDB_API_KEY=your_key"
            _title=$(printf "%s" "$_selection" | sed -nE 's/.*\[TV\][[:space:]]+(.*)[[:space:]]+\|[[:space:]]+ID:.*/\1/p' | sed -E 's/\(S[0-9]+E[0-9]+\)//; s/[[:space:]]*$//')
            _id=$(printf "%s" "$_selection" | sed -nE 's/.*ID:(.*)$/\1/p')
            run_tv_selection "$_id" "$_title"
            ;;
        *'[ANIME]'*)
            _id=$(printf "%s" "$_selection" | sed -nE 's/.*ID:(.*)$/\1/p')
            if printf "%s" "$_selection" | grep -q "(Episode "; then
                tab="$(printf '\t')"
                _entry=$(grep -E "^[^$tab]+$tab${_id}$tab" "$histfile" | tail -n1)
                ep_no=$(printf "%s" "$_entry" | cut -f1)
                title=$(printf "%s" "$_entry" | cut -f3)
                media_mode="anime"
                search="history"
                ep_list=$(episodes_list "$_id")
                allanime_title="$(printf "%s" "$title" | cut -d'(' -f1 | tr -d '[:punct:]')"
                skip_search=1
                id="$_id"
                play
            else
                _title=$(printf "%s" "$_selection" | sed -nE 's/.*\[ANIME\][[:space:]]+(.*)[[:space:]]+\|[[:space:]]+ID:.*/\1/p' | sed 's/[[:space:]]*$//')
                media_mode="anime"
                title="$_title"
                id="$_id"
                ep_list=$(episodes_list "$_id")
                [ -z "$ep_no" ] && ep_no=$(printf "%s" "$ep_list" | nth "Select episode: " "$multi_selection_flag")
                [ -z "$ep_no" ] && exit 1
                allanime_title="$(printf "%s" "$title" | cut -d'(' -f1 | tr -d '[:punct:]')"
                play
            fi
            ;;
        *) ;;
    esac
}

# MAIN

# setup
agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:150.0) Gecko/20100101 Firefox/150.0"
allanime_refr="https://youtu-chan.com"
allanime_base="allanime.day"
allanime_api="https://api.${allanime_base}"
allanime_key="$(printf '%s' 'Xot36i3lK3:v1' | openssl dgst -sha256 -binary | od -A n -t x1 | tr -d ' \n')"
mode="${CINEFLIX_CLI_MODE:-sub}"
download_dir="${CINEFLIX_CLI_DOWNLOAD_DIR:-.}"
log_episode="${CINEFLIX_CLI_LOG:-1}"
quality="${CINEFLIX_CLI_QUALITY:-best}"
case "$(uname -a | cut -d " " -f 1,3-)" in
    *Darwin*) player_function="${CINEFLIX_CLI_PLAYER:-$(where_iina)}" ;;   # mac OS
    *ndroid*) player_function="${CINEFLIX_CLI_PLAYER:-android_mpv}" ;;     # Android OS (termux)
    *MINGW* | *WSL2*) player_function="${CINEFLIX_CLI_PLAYER:-mpv.exe}" ;; # Windows OS
    *ish*) player_function="${CINEFLIX_CLI_PLAYER:-iSH}" ;;                # iOS (iSH)
    *) player_function="${CINEFLIX_CLI_PLAYER:-$(where_mpv)}" ;;           # Linux OS
esac

no_detach="${CINEFLIX_CLI_NO_DETACH:-0}"
exit_after_play="${CINEFLIX_CLI_EXIT_AFTER_PLAY:-0}"
use_external_menu="${CINEFLIX_CLI_EXTERNAL_MENU:-0}"
external_menu_normal_window="${CINEFLIX_CLI_EXTERNAL_MENU_NORMAL_WINDOW:-0}"
skip_intro="${CINEFLIX_CLI_SKIP_INTRO:-0}"
skip_title="${CINEFLIX_CLI_SKIP_TITLE:-}"
[ -t 0 ] || (command -v dmenu && use_external_menu=2)
[ -t 0 ] || (command -v rofi && use_external_menu=1)
hist_dir="${CINEFLIX_CLI_HIST_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/cineflix-cli}"
[ ! -d "$hist_dir" ] && mkdir -p "$hist_dir"
histfile="$hist_dir/cineflix-hsts"
[ ! -f "$histfile" ] && : >"$histfile"
search="${CINEFLIX_CLI_DEFAULT_SOURCE:-scrape}"
branch="${CINEFLIX_CLI_BRANCH:-master}"
# media_mode toggles pipelines: interactive (default landing), movie, anime
media_mode="${CINEFLIX_MODE:-interactive}"
# tmdb_media_type selects which TMDB search endpoint to use (multi/movie/tv)
tmdb_media_type="multi"
# location of the embedded scraper project, resolved next to the script by default
script_dir="$(CDPATH='' cd -- "$(dirname -- "$0")" 2>/dev/null && pwd)"
core_dir="${CINEFLIX_CORE_DIR:-${script_dir:-.}/core}"

while [ $# -gt 0 ]; do
    case "$1" in
        -v | --vlc)
            case "$(uname -a | cut -d " " -f 1,3-)" in
                *ndroid*) player_function="android_vlc" ;;
                MINGW* | *WSL2*) player_function="vlc.exe" ;;
                *ish*) player_function="iSH" ;;
                *) player_function="vlc" ;;
            esac
            ;;
        -s | --syncplay)
            case "$(uname -s)" in
                Darwin*) player_function="/Applications/Syncplay.app/Contents/MacOS/syncplay" ;;
                MINGW* | *Msys)
                    export PATH="$PATH":"/c/Program Files (x86)/Syncplay/"
                    player_function="syncplay.exe"
                    ;;
                *) player_function="syncplay" ;;
            esac
            ;;
        -q | --quality)
            [ $# -lt 2 ] && die "missing argument!"
            quality="$2"
            shift
            ;;
        -S | --select-nth)
            [ $# -lt 2 ] && die "missing argument!"
            index="$2"
            shift
            ;;
        --search-all)
            [ $# -lt 2 ] && die "missing argument!"
            search_all "$2"
            exit 0
            ;;
        -c | --continue) search=history; media_mode="anime" ;;
        -t | --tv | -tv | tv) media_mode="movie"; tmdb_media_type="tv" ;;
        -m | --movie | -movie | m | movie | --movie-only) media_mode="movie"; tmdb_media_type="movie" ;;
        -a | --anime | -anime | anime) media_mode="anime" ;;
        -d | --download)
            [ "$player_function" = "iSH" ] && iSH_DownFix="--async-dns=false"
            player_function=download
            ;;
        -D | --delete)
            : >"$histfile"
            exit 0
            ;;
        -l | --logview)
            case "$(uname -s)" in
                Darwin*) log show --predicate 'process == "logger"' ;;
                Linux*) journalctl -t cineflix-cli ;;
                *) die "Logger not implemented for your platform" ;;
            esac
            exit 0
            ;;
        -V | --version) version_info ;;
        -h | --help) help_info ;;
        -e | --episode | -r | --range)
            [ $# -lt 2 ] && die "missing argument!"
            ep_no="$2"
            shift
            ;;
        --dub) mode="dub" ;;
        --no-detach) no_detach=1 ;;
        --exit-after-play) exit_after_play=1 && no_detach=1 ;;
        --rofi) use_external_menu=1 ;;
        --dmenu) use_external_menu=2 ;;
        --skip) skip_intro=1 ;;
        --skip-title)
            [ $# -lt 2 ] && die "missing argument!"
            skip_title="$2"
            shift
            ;;
        -N | --nextep-countdown) search=nextep ;;
        -U | --update)
            branch="${2:-$branch}"
            update_script
            ;;
        *) query="$(printf "%s" "$query $1" | sed "s|^ ||;s| |+|g")" ;;
    esac
    shift
done
[ "$use_external_menu" = "0" ] && multi_selection_flag="${CINEFLIX_CLI_MULTI_SELECTION:-"-m"}"
[ "$use_external_menu" = "1" ] && multi_selection_flag="${CINEFLIX_CLI_MULTI_SELECTION:-"-multi-select"}"
[ "$external_menu_normal_window" = "1" ] && external_menu_args="-normal-window"
save_term_title
set_term_title "Cineflix"

# resolve interactive mode: if a specific mode wasn't chosen, infer from context
if [ "$media_mode" = "interactive" ]; then
    case "$search" in
        history|nextep) media_mode="anime" ;;  # -c and -N are anime-specific
        *) [ -n "$query" ] && media_mode="anime" ;;  # bare query defaults to anime
    esac
fi

log_info "Checking dependencies…"
dep_ch "curl" "sed" "grep"
case "$(uname -o 2>/dev/null)" in
    *ndroid*) command -v openssl >/dev/null || die 'Program "openssl" not found. On Termux, install with: pkg install openssl-tool' ;;
    *) dep_ch "openssl" ;;
esac
[ "$skip_intro" = 1 ] && dep_ch "ani-skip"

# Check if fzf is actually needed
_needs_fzf=0
if [ "$use_external_menu" = "0" ]; then
    if [ "$media_mode" = "interactive" ]; then
        _needs_fzf=1
    elif [ "$search" = "history" ] && [ -z "$index" ]; then
        _needs_fzf=1
    elif [ -z "$index" ] || [ -z "$ep_no" ]; then
        _needs_fzf=1
    fi
fi
[ "$_needs_fzf" = 1 ] && dep_ch "fzf"

if [ "$media_mode" = "movie" ] || { [ "$media_mode" = "interactive" ] && [ -n "$TMDB_API_KEY" ]; }; then
    dep_ch "jq"
fi
case "$player_function" in
    debug) ;;
    download) dep_ch "ffmpeg" "aria2c" ;;
    android*) log_warn "Player checking disabled on Android."
        log_dim "CINEFLIX-CLI recommends Android MPV for full compatibility."
        log_dim "Add: include='/storage/emulated/0/mpv/mpv.config.mp4'"
        log_dim "to: MPV > Settings > Advanced > mpv.conf" ;;
    *iSH*) log_warn "Player checking disabled on iOS." ;;
    flatpak_mpv) true ;; # handled out of band in where_mpv
    *) dep_ch "$player_function" ;;
esac

# idk where to put this, so I put it here...
trap 'cleanup; exit 1' INT HUP

# interactive mode: show the unified landing UI, then re-route
[ "$media_mode" = "interactive" ] && {
    interactive_mode
    # interactive_mode sets media_mode and query; re-check deps for chosen mode
    [ "$media_mode" = "movie" ] && (dep_ch "jq" || true)
}

# movie/TV mode runs as a separate pipeline, leaving the anime flow below untouched
[ "$media_mode" = "movie" ] && {
    run_movie_mode "$query"
    exit 0
}

# searching
if [ "$skip_search" != 1 ]; then
    case "$search" in
        history)
            anime_list=$(while read -r ep_no id title || [ -n "$ep_no" ]; do
                case "$ep_no" in
                    '[MOVIE]'*|'[TV]'*) continue ;;
                    *) ;;
                esac
                process_hist_entry &
            done <"$histfile")
            wait
            [ -z "$anime_list" ] && die "No unwatched series in history!"
            [ -z "${index##*[!0-9]*}" ] && id=$(printf "%s" "$anime_list" | nl -w 2 | sed 's/^[[:space:]]//' | nth "Select anime: " | cut -f1)
            [ -z "${index##*[!0-9]*}" ] || id=$(printf "%s" "$anime_list" | sed -n "${index}p" | cut -f1)
            [ -z "$id" ] && exit 1
            title=$(printf "%s" "$anime_list" | grep -E '^'"$id"'\t' | cut -f2 | sed 's/ - episode.*//')
            ep_list=$(episodes_list "$id")
            ep_no=$(printf "%s" "$anime_list" | grep -E '^'"$id"'\t' | cut -f2 | sed -nE 's/.*- episode (.+)$/\1/p')
            allanime_title="$(printf "%s" "$title" | cut -d'(' -f1 | tr -d '[:punct:]')"
            ;;
        *)
            if [ "$use_external_menu" = "0" ]; then
                while [ -z "$query" ]; do
                    printf '\033[1;36m [➜] Search anime: \033[0m' && read -r query
                done
            else
                [ -z "$query" ] && query=$(printf "" | external_menu "" "Search anime: " "$external_menu_args")
                [ -z "$query" ] && exit 1
            fi
            # for checking new releases by specifying anime name
            [ "$search" = "nextep" ] && time_until_next_ep "$query"

            query=$(printf "%s" "$query" | sed "s| |+|g")
            set_term_title "Cineflix │ Searching: $(printf '%s' "$query" | tr '+' ' ' || true)"
            spin_start "Searching anime…"
            anime_list=$(search_anime "$query")
            spin_stop
            [ -z "$anime_list" ] && die "No results found!"
            [ "$index" -eq "$index" ] 2>/dev/null && result=$(printf "%s" "$anime_list" | sed -n "${index}p")
            [ -z "$index" ] && result=$(printf "%s" "$anime_list" | nl -w 2 | sed 's/^[[:space:]]//' | nth "Select anime: ")
            [ -z "$result" ] && exit 1
            title=$(printf "%s" "$result" | cut -f2)
            allanime_title="$(printf "%s" "$title" | cut -d'(' -f1 | tr -d '[:punct:]')"
            id=$(printf "%s" "$result" | cut -f1)
            ep_list=$(episodes_list "$id")
            [ -z "$ep_no" ] && ep_no=$(printf "%s" "$ep_list" | nth "Select episode: " "$multi_selection_flag")
            [ -z "$ep_no" ] && exit 1
            ;;
    esac
fi
[ "$skip_intro" = 1 ] && mal_id="$(ani-skip -q "${skip_title:-${title}}")"

# moves the cursor up one line and clears that line
tput cuu1 && tput el
# stores the position of cursor
tput sc

# playback & loop
set_term_title "Cineflix │ Streaming: $title"
play
[ "$player_function" = "download" ] || [ "$player_function" = "debug" ] && exit 0

while cmd=$(printf "next\nreplay\nprevious\nselect\nchange_quality\nquit" | nth "Playing episode $ep_no of $title... "); do
    case "$cmd" in
        next) ep_no=$(printf "%s" "$ep_list" | sed -n "/^${ep_no}$/{n;p;}") 2>/dev/null ;;
        replay) episode="$replay" ;;
        previous) ep_no=$(printf "%s" "$ep_list" | sed -n "/^${ep_no}$/{g;1!p;};h") 2>/dev/null ;;
        select) ep_no=$(printf "%s" "$ep_list" | nth "Select episode: " "$multi_selection_flag") ;;
        change_quality)
            new_quality="$(printf "%s" "$links" | launcher | cut -d\> -f1)"
            select_quality "$new_quality"
            ;;
        *)
            cleanup
            exit 0
            ;;
    esac
    [ -z "$ep_no" ] && die "Out of range"
    play
done

