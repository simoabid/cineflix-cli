# ── Spinner ──────────────────────────────────────────────────────
_spin_pid=""
spin_start() {
    _spin_msg="${1:-Loading}"
    (
        while true; do
            for _c in '⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏'; do
                printf '\33[2K\r\033[1;36m %s \033[0;37m%s\033[0m' "$_c" "$_spin_msg" >&2
                sleep 0.1
            done
        done
    ) &
    _spin_pid=$!
}
spin_stop() {
    [ -n "$_spin_pid" ] && kill "$_spin_pid" 2>/dev/null && wait "$_spin_pid" 2>/dev/null
    _spin_pid=""
    printf '\33[2K\r' >&2
}

