update_script() {
    printf "[branch:%s] Checking for Update..\n" "$branch"
    new_script="$(curl --fail-with-body --max-time 15 -sL -A "$agent" "https://raw.githubusercontent.com/simoabid/cineflix-cli/$branch/cineflix-cli")" || die "[branch:$branch] Connection error: $new_script"
    printf '%s' "$new_script" | grep -q "^version_number" || die "[branch:$branch] Invalid Response."
    new_ver=$(printf '%s' "$new_script" | sed -nE 's/^version_number="([^"]*)"/\1/p')
    if [ "$new_ver" = "$version_number" ]; then
        printf "[branch:%s] Script is up to date :)\n" "$branch"
    else
        _dir=$(dirname "$0")
        _tmp_update=$(mktemp "$_dir/cineflix-cli.XXXXXX" 2>/dev/null || mktemp "/tmp/cineflix-cli.XXXXXX")
        if printf '%s' "$new_script" > "$_tmp_update" && chmod +x "$_tmp_update" && mv "$_tmp_update" "$0"; then
            printf "[branch:%s] Script has been updated to %s\n" "$branch" "$new_ver"
        else
            rm -f "$_tmp_update"
            die "[branch:$branch] Can't update for some reason! Make sure you have write permissions to $0"
        fi
    fi
    exit 0
}

